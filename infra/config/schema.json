{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "infra/config/dev.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["ambiente", "regiao", "destroy", "negocio", "api", "dynamodb_capacidade", "lambda", "observabilidade", "gateway_mock"],
  "$defs": {
    "capacidade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rcu", "wcu"],
      "properties": {"rcu": {"type": "integer", "minimum": 1}, "wcu": {"type": "integer", "minimum": 1}}
    },
    "prazo": {"type": "integer", "minimum": 60, "maximum": 2592000},
    "rps": {"type": "integer", "exclusiveMinimum": 0, "maximum": 10000}
  },
  "properties": {
    "ambiente": {"const": "dev"},
    "regiao": {"const": "us-east-1"},
    "destroy": {"type": "boolean"},
    "negocio": {
      "type": "object", "additionalProperties": false,
      "required": ["prazo_pagamento_segundos", "prazo_retirada_segundos", "retencao_inativos_dias", "versao_termo_vigente"],
      "properties": {
        "prazo_pagamento_segundos": {"$ref": "#/$defs/prazo"},
        "prazo_retirada_segundos": {"$ref": "#/$defs/prazo"},
        "retencao_inativos_dias": {"type": "integer", "minimum": 1},
        "versao_termo_vigente": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-v[0-9]+$"}
      }
    },
    "api": {
      "type": "object", "additionalProperties": false, "required": ["cors_origens", "throttling"],
      "properties": {
        "cors_origens": {"type": "array", "items": {"type": "string", "pattern": "^https://[^*]+$"}},
        "throttling": {
          "type": "object", "additionalProperties": false,
          "required": ["stage_rps", "stage_burst", "post_vendas_rps", "post_clientes_rps", "webhook_rps"],
          "properties": {
            "stage_rps": {"$ref": "#/$defs/rps"}, "stage_burst": {"$ref": "#/$defs/rps"},
            "post_vendas_rps": {"$ref": "#/$defs/rps"}, "post_clientes_rps": {"$ref": "#/$defs/rps"},
            "webhook_rps": {"$ref": "#/$defs/rps"}
          }
        }
      }
    },
    "dynamodb_capacidade": {
      "type": "object", "additionalProperties": false,
      "required": ["veiculos", "veiculos_gsi_status_preco", "clientes", "vendas", "vendas_gsi_cliente", "vendas_gsi_status", "pagamentos", "idempotencia", "gateway_mock"],
      "properties": {
        "veiculos": {"$ref": "#/$defs/capacidade"}, "veiculos_gsi_status_preco": {"$ref": "#/$defs/capacidade"},
        "clientes": {"$ref": "#/$defs/capacidade"}, "vendas": {"$ref": "#/$defs/capacidade"},
        "vendas_gsi_cliente": {"$ref": "#/$defs/capacidade"}, "vendas_gsi_status": {"$ref": "#/$defs/capacidade"},
        "pagamentos": {"$ref": "#/$defs/capacidade"}, "idempotencia": {"$ref": "#/$defs/capacidade"},
        "gateway_mock": {"$ref": "#/$defs/capacidade"}
      }
    },
    "lambda": {
      "type": "object", "additionalProperties": false, "required": ["memoria_api_mb", "memoria_worker_mb"],
      "properties": {
        "memoria_api_mb": {"type": "integer", "minimum": 128, "maximum": 3008},
        "memoria_worker_mb": {"type": "integer", "minimum": 128, "maximum": 3008}
      }
    },
    "observabilidade": {
      "type": "object", "additionalProperties": false,
      "required": ["retencao_logs_dias", "retencao_auditoria_dias", "xray_amostragem"],
      "properties": {
        "retencao_logs_dias": {"enum": [1, 3, 5, 7, 14, 30, 60, 90]},
        "retencao_auditoria_dias": {"enum": [1827, 2192, 2557, 2922, 3288, 3653]},
        "xray_amostragem": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "gateway_mock": {
      "type": "object", "additionalProperties": false, "required": ["habilitado"],
      "properties": {"habilitado": {"type": "boolean"}}
    }
  }
}
