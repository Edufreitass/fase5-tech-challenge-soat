{
  "Comment": "Saga de compra de veiculo (orquestrada)",
  "StartAt": "EmitirCodigoPagamento",
  "States": {
    "EmitirCodigoPagamento": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_pagamentos_worker_arn}",
        "Payload": {
          "acao": "EMITIR_CODIGO",
          "vendaId.$": "$.vendaId",
          "clienteId.$": "$.clienteId",
          "valorCentavos.$": "$.valorCentavos",
          "prazoSegundos.$": "$.prazos.pagamentoSegundos"
        }
      },
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Erro.Transitorio",
            "DependenciaIndisponivel"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 6,
          "JitterStrategy": "FULL"
        }
      ],
      "ResultPath": "$.pagamento",
      "ResultSelector": {
        "pagamentoId.$": "$.Payload.pagamentoId",
        "expiraEm.$": "$.Payload.expiraEm"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "MotivoFalhaEmissao"
        }
      ],
      "Next": "MarcarAguardandoPagamento"
    },
    "MarcarAguardandoPagamento": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_vendas_worker_arn}",
        "Payload": {
          "acao": "ATUALIZAR_VENDA",
          "vendaId.$": "$.vendaId",
          "de": "RESERVADO",
          "para": "AGUARDANDO_PAGAMENTO",
          "ator": "SISTEMA",
          "definir": {
            "pagamentoId.$": "$.pagamento.pagamentoId"
          }
        }
      },
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Erro.Transitorio",
            "DependenciaIndisponivel"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 6,
          "JitterStrategy": "FULL"
        }
      ],
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "FalhaCompensacao"
        }
      ],
      "Next": "AguardarPagamento"
    },
    "AguardarPagamento": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${fn_vendas_worker_arn}",
        "Payload": {
          "acao": "REGISTRAR_TOKEN",
          "etapa": "PAGAMENTO",
          "vendaId.$": "$.vendaId",
          "pagamentoId.$": "$.pagamento.pagamentoId",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "TimeoutSecondsPath": "$.prazos.pagamentoSegundos",
      "ResultPath": "$.resultadoPagamento",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 6,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "Pagamento.Recusado"
          ],
          "ResultPath": "$.erro",
          "Next": "MotivoRecusado"
        },
        {
          "ErrorEquals": [
            "Venda.Desistencia"
          ],
          "ResultPath": "$.erro",
          "Next": "MotivoDesistencia"
        },
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.erro",
          "Next": "MotivoExpirado"
        }
      ],
      "Next": "MarcarVendaPaga"
    },
    "MarcarVendaPaga": {
