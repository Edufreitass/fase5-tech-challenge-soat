            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "FalhaCompensacao"
        }
      ],
      "Next": "Concluido"
    },
    "Concluido": {
      "Type": "Succeed"
    },
    "MotivoRecusado": {
      "Type": "Pass",
      "Result": {
        "motivo": "RECUSADO",
        "statusAtual": "AGUARDANDO_PAGAMENTO"
      },
      "ResultPath": "$.cancelamento",
      "Next": "LiberarVeiculoCancelamento"
    },
    "MotivoDesistencia": {
      "Type": "Pass",
      "Result": {
        "motivo": "DESISTENCIA",
        "statusAtual": "AGUARDANDO_PAGAMENTO"
      },
      "ResultPath": "$.cancelamento",
      "Next": "CancelarCodigoPagamento"
