          "tipo": "VendaConcluida",
          "ocorridoEm.$": "$$.State.EnteredTime",
          "correlationId.$": "$.correlationId",
          "vendaId.$": "$.vendaId",
          "clienteId.$": "$.clienteId",
          "veiculoId.$": "$.veiculoId"
        },
        "MessageAttributes": {
          "tipo": {
            "DataType": "String",
