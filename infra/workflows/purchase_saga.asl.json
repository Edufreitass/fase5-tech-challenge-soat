        "FunctionName": "${fn_vendas_worker_arn}",
        "Payload": {
          "acao": "ATUALIZAR_VENDA",
          "vendaId.$": "$.vendaId",
          "de": "PAGO",
          "para": "ESTORNADO",
          "motivo.$": "$.cancelamento.motivo",
          "ator": "SISTEMA"
        }
      },
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Erro.Transitorio",
            "DependenciaIndisponivel"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 6,
          "JitterStrategy": "FULL"
        }
      ],
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "FalhaCompensacao"
        }
      ],
      "Next": "LiberarLockEstornada"
    },
    "LiberarLockEstornada": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_vendas_worker_arn}",
        "Payload": {
          "acao": "LIBERAR_LOCK",
          "vendaId.$": "$.vendaId",
          "clienteId.$": "$.clienteId"
        }
      },
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Erro.Transitorio",
            "DependenciaIndisponivel"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 6,
          "JitterStrategy": "FULL"
        }
      ],
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "FalhaCompensacao"
        }
      ],
      "Next": "PublicarVendaEstornada"
    },
    "PublicarVendaEstornada": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${topico_eventos_arn}",
        "Message": {
          "versaoEvento": 1,
          "tipo": "VendaEstornada",
          "ocorridoEm.$": "$$.State.EnteredTime",
          "correlationId.$": "$.correlationId",
          "vendaId.$": "$.vendaId",
          "clienteId.$": "$.clienteId",
          "veiculoId.$": "$.veiculoId",
          "motivo.$": "$.cancelamento.motivo"
        },
        "MessageAttributes": {
          "tipo": {
            "DataType": "String",
            "StringValue": "VendaEstornada"
          }
        }
      },
      "ResultPath": null,
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Erro.Transitorio",
            "DependenciaIndisponivel"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 6,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "FalhaCompensacao"
        }
      ],
      "Next": "Estornado"
    },
    "Estornado": {
      "Type": "Succeed"
    },
    "FalhaCompensacao": {
      "Type": "Fail",
      "Error": "FalhaCompensacao",
      "Cause": "Falha em passo da saga apos retries; use POST /administracao/vendas/{id}/fluxo/reprocessamento"
    },
    "ResolverRetirada": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_vendas_worker_arn}",
        "Payload": {
          "acao": "RESOLVER_RETIRADA",
          "vendaId.$": "$.vendaId"
        }
      },
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Erro.Transitorio",
            "DependenciaIndisponivel"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 6,
          "JitterStrategy": "FULL"
        }
      ],
      "ResultPath": "$.resolucaoRetirada",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.erro",
          "Next": "FalhaCompensacao"
        }
      ],
      "Next": "RetiradaRegistrada",
      "ResultSelector": {
        "registrada.$": "$.Payload.retiradaRegistrada"
      }
    },
    "RetiradaRegistrada": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.resolucaoRetirada.registrada",
          "BooleanEquals": true,
          "Next": "BaixarVeiculo"
        }
      ],
      "Default": "MotivoNaoRetirado"
    }
  }
}
