        <mxCell id="legend-1-badge" value="1" style="fontFamily=Helvetica;html=1;ellipse;aspect=fixed;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
