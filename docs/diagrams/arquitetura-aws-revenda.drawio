        </mxCell>
        <mxCell id="gaps" value="&lt;b&gt;Não implementados (apenas documentados, por custo)&lt;/b&gt;&lt;br&gt;WAF, GuardDuty, Security Hub, Macie, CMK própria, PITR e CloudTrail próprio. Esses controles não são substituídos integralmente por throttling, testes ou migrações." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;text;fontSize=21;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1">
