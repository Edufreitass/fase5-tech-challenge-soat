        <mxCell id="legend-1-text" value="&lt;div&gt;&lt;b&gt;Início do pagamento&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Worker chama a rota interna assinada com SigV4.&lt;/div&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;text;fontSize=15;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1895" y="250" width="345" height="95" />
        </mxCell>
        <mxCell id="legend-2-badge" value="2" style="fontFamily=Helvetica;html=1;ellipse;aspect=fixed;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1850" y="362" width="30" height="30" />
        </mxCell>
        <mxCell id="legend-2-text" value="&lt;b&gt;Gateway de teste&lt;/b&gt;&lt;br&gt;Cria cobrança. Funcionário simula pagamento via Cognito; estorno também gera evento." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;text;fontSize=15;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1895" y="362" width="345" height="95" />
        </mxCell>
        <mxCell id="legend-3-badge" value="3" style="fontFamily=Helvetica;html=1;ellipse;aspect=fixed;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1850" y="474" width="30" height="30" />
        </mxCell>
        <mxCell id="legend-3-text" value="&lt;b&gt;Enfileiramento&lt;/b&gt;&lt;br&gt;Gateway simulado envia a resposta à fila de webhooks com atraso." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;text;fontSize=15;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1895" y="474" width="345" height="95" />
        </mxCell>
        <mxCell id="legend-4-badge" value="4" style="fontFamily=Helvetica;html=1;ellipse;aspect=fixed;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1850" y="586" width="30" height="30" />
        </mxCell>
        <mxCell id="legend-4-text" value="&lt;b&gt;Consumo assíncrono&lt;/b&gt;&lt;br&gt;Lambda consome as mensagens da fila de webhooks." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;text;fontSize=15;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1895" y="586" width="345" height="95" />
        </mxCell>
        <mxCell id="legend-5-badge" value="5" style="fontFamily=Helvetica;html=1;ellipse;aspect=fixed;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1850" y="698" width="30" height="30" />
        </mxCell>
        <mxCell id="legend-5-text" value="&lt;b&gt;Callback e validação&lt;/b&gt;&lt;br&gt;Consumidor envia o callback REST; handler valida HMAC e aplica idempotência." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;text;fontSize=15;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1895" y="698" width="345" height="95" />
        </mxCell>
        <mxCell id="legend-6-badge" value="6" style="fontFamily=Helvetica;html=1;ellipse;aspect=fixed;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1850" y="810" width="30" height="30" />
        </mxCell>
        <mxCell id="legend-6-text" value="&lt;b&gt;Retorno à espera&lt;/b&gt;&lt;br&gt;SendTaskSuccess/Failure retoma a etapa. Reentrega recupera callback transitório." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;text;fontSize=15;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1895" y="810" width="345" height="95" />
        </mxCell>
        <mxCell id="legend-7-badge" value="7" style="fontFamily=Helvetica;html=1;ellipse;aspect=fixed;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1850" y="922" width="30" height="30" />
        </mxCell>
        <mxCell id="legend-7-text" value="&lt;div&gt;&lt;b&gt;Persistência&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Status e chaves de idempotência ficam no DynamoDB.&lt;/div&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;text;fontSize=15;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1895" y="922" width="345" height="95" />
        </mxCell>
        <mxCell id="legend-8-badge" value="8" style="fontFamily=Helvetica;html=1;ellipse;aspect=fixed;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1850" y="1034" width="30" height="30" />
        </mxCell>
        <mxCell id="legend-8-text" value="&lt;div&gt;&lt;b&gt;Falhas&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Mensagens não processadas seguem para a DLQ.&lt;/div&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;text;fontSize=15;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1895" y="1034" width="345" height="95" />
        </mxCell>
        <mxCell id="legend-note-0" value="Ícones nativos AWS4. Grupos tracejados cinza indicam agrupamento lógico, não VPC ou subnet." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#232F3E;text;fontSize=13;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1">
